generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Team ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("MEMBER") // ADMIN | MEMBER | BOOKKEEPER
  createdAt    DateTime @default(now())
}

// ---------- Products & BOM ----------

model Product {
  id             String  @id @default(cuid())
  sku            String  @unique
  name           String
  tier           String  @default("BLANCO") // BLANCO | REPOSADO | ANEJO | OTHER
  sizeMl         Int     @default(750)
  abv            Float   @default(40)
  bottlesPerCase Int     @default(6)
  casesPerPallet Int     @default(140)
  laborPerBottleCents Int @default(0) // bottling labor & overhead — part of COGS, not a tracked dry good
  caseCostCents  Int     @default(0) // production cost per case; auto-derived from BOM + labor when a BOM exists
  exWorksCents   Int     @default(0) // FOB / ex-works price per case to the importer
  active         Boolean @default(true)

  bomItems       BomItem[]
  productionRuns ProductionRun[]
  movements      InventoryMovement[]
  saleLines      ExWorksLine[]
  depletions     Depletion[]
  channelStocks  ChannelStock[]
  skuDepletions  SkuDepletion[]
}

// ---------- Suppliers, dry goods & purchasing (Mexico) ----------

model Supplier {
  id          String @id @default(cuid())
  name        String
  location    String @default("")
  contactName String @default("")
  email       String @default("")
  phone       String @default("")
  notes       String @default("")

  components     Component[]
  purchaseOrders PurchaseOrder[]
}

model Component {
  id             String    @id @default(cuid())
  name           String
  category       String    @default("OTHER") // GLASS | LABEL | CLOSURE | SHIPPER | CAPSULE | BULK_TEQUILA | OTHER
  unit           String    @default("pcs") // pcs | liters
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  unitCostCents  Int       @default(0)
  leadTimeDays   Int       @default(30)
  reorderPoint   Float     @default(0) // flag when on-hand drops below this
  notes          String    @default("")
  active         Boolean   @default(true)

  movements ComponentMovement[]
  bomItems  BomItem[]
  poLines   PurchaseOrderLine[]
}

model ComponentMovement {
  id          String    @id @default(cuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id])
  date        DateTime  @default(now())
  type        String // PO_RECEIPT | PRODUCTION | ADJUSTMENT
  qty         Float // signed
  reference   String    @default("")
  notes       String    @default("")
}

model BomItem {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  qty         Float // amount consumed
  per         String    @default("BOTTLE") // BOTTLE | CASE

  @@unique([productId, componentId])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  status       String    @default("ORDERED") // ORDERED | RECEIVED | CANCELLED
  orderDate    DateTime
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String    @default("")

  lines PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  componentId   String
  component     Component     @relation(fields: [componentId], references: [id])
  qty           Float
  unitCostCents Int           @default(0)
}

// ---------- Production & finished goods (Mexico) ----------

model Warehouse {
  id       String @id @default(cuid())
  name     String
  location String @default("")

  movements InventoryMovement[]
  runs      ProductionRun[]
  sales     ExWorksSale[]
}

model ProductionRun {
  id              String    @id @default(cuid())
  lotCode         String    @unique
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  status          String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  startDate       DateTime
  bottledDate     DateTime?
  bottlesPlanned  Int
  bottlesProduced Int       @default(0)
  agaveSource     String    @default("")
  distillery      String    @default("")
  totalCostCents  Int       @default(0)
  notes           String    @default("")

  movements InventoryMovement[]
}

model InventoryMovement {
  id              String         @id @default(cuid())
  date            DateTime       @default(now())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  type            String // PRODUCTION | EX_WORKS_SALE | ADJUSTMENT | SAMPLES
  bottles         Int // signed
  productionRunId String?
  productionRun   ProductionRun? @relation(fields: [productionRunId], references: [id])
  saleId          String?
  sale            ExWorksSale?   @relation(fields: [saleId], references: [id])
  notes           String         @default("")
}

// ---------- Market: importer, distributors, sales, channel ----------

model Importer {
  id          String @id @default(cuid())
  name        String
  country     String @default("USA")
  contactName String @default("")
  email       String @default("")
  phone       String @default("")
  notes       String @default("")

  distributors    Distributor[]
  sales           ExWorksSale[]
  channelStocks   ChannelStock[]
  marketSnapshots MarketSnapshot[]
  chainVolumes    ChainVolume[]
  chargebacks     Chargeback[]
}

model Distributor {
  id         String   @id @default(cuid())
  importerId String
  importer   Importer @relation(fields: [importerId], references: [id])
  name       String
  market     String   @default("") // state / region
  notes      String   @default("")

  depletions    Depletion[]
  channelStocks ChannelStock[]
}

model ExWorksSale {
  id            String    @id @default(cuid())
  importerId    String
  importer      Importer  @relation(fields: [importerId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  date          DateTime
  status        String    @default("DRAFT") // DRAFT | CONFIRMED
  invoiceNumber String    @default("")
  invoiceStatus String    @default("UNPAID") // UNPAID | PAID
  paidDate      DateTime?
  notes         String    @default("")

  lines       ExWorksLine[]
  movements   InventoryMovement[]
  chargebacks Chargeback[]
}

/// A cost the importer bills back to the brand (distributor promos, samples,
/// freight, marketing). LSI settles these as credits against what they owe —
/// linking one to an invoice reduces that invoice's collectible balance.
model Chargeback {
  id         String       @id @default(cuid())
  importerId String
  importer   Importer     @relation(fields: [importerId], references: [id])
  saleId     String? // invoice the credit is applied against (null = unapplied)
  sale       ExWorksSale? @relation(fields: [saleId], references: [id])
  date       DateTime
  category   String       @default("OTHER") // DISTRIBUTOR_PROMO | SAMPLES | FREIGHT | MARKETING | OTHER
  amountCents Int
  reference  String       @default("") // LSI statement / billback number
  notes      String       @default("")
  createdAt  DateTime     @default(now())
}

model ExWorksLine {
  id                String      @id @default(cuid())
  saleId            String
  sale              ExWorksSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  cases             Int
  pricePerCaseCents Int
}

/// Point-in-time stock reported by the importer for themselves or a distributor.
model ChannelStock {
  id            String       @id @default(cuid())
  holderType    String // IMPORTER | DISTRIBUTOR
  importerId    String?
  importer      Importer?    @relation(fields: [importerId], references: [id])
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  period        String // YYYY-MM
  cases         Float
  source        String       @default("MANUAL") // MANUAL | IMPORT
  createdAt     DateTime     @default(now())
}

model Depletion {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])
  productId     String? // null = brand-level (importer reports don't break out SKUs)
  product       Product?    @relation(fields: [productId], references: [id])
  period        String // YYYY-MM
  accountName   String      @default("")
  accountType   String      @default("UNKNOWN") // ON_PREMISE | OFF_PREMISE | UNKNOWN
  cases         Float // 9L-equivalent cases (industry standard)
  source        String      @default("MANUAL") // MANUAL | IMPORT | REPORT
  createdAt     DateTime    @default(now())
}

/// National per-SKU monthly depletions (the report's "Variants" section).
model SkuDepletion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  period    String // YYYY-MM
  cases     Float // 9L equivs
  source    String   @default("REPORT")
  createdAt DateTime @default(now())
}

/// YTD volume by retail chain (the report's "Top 20 Chain" section).
model ChainVolume {
  id         String   @id @default(cuid())
  importerId String
  importer   Importer @relation(fields: [importerId], references: [id])
  period     String // report month YYYY-MM
  chain      String
  ytdCases   Float
  ytdCasesLY Float?
  createdAt  DateTime @default(now())
}

/// YTD trade stats per market, from the importer's commercial report.
model MarketSnapshot {
  id           String   @id @default(cuid())
  importerId   String
  importer     Importer @relation(fields: [importerId], references: [id])
  period       String // report month YYYY-MM
  market       String // state code
  ytdCases     Float // 9L equivs
  ytdCasesLY   Float?
  accounts     Int
  accountsLY   Int?
  velocity     Float?
  createdAt    DateTime @default(now())
}

// ---------- Marketing ----------

model SocialPost {
  id      String   @id @default(cuid())
  date    DateTime
  channel String   @default("INSTAGRAM") // INSTAGRAM | TIKTOK | YOUTUBE | EMAIL | OTHER
  title   String
  notes   String   @default("")
  status  String   @default("IDEA") // IDEA | DRAFTED | SCHEDULED | POSTED
}

model Partner {
  id        String   @id @default(cuid())
  type      String   @default("INFLUENCER") // INFLUENCER | PRESS
  name      String
  handle    String   @default("")
  platform  String   @default("") // Instagram / TikTok / publication name
  market    String   @default("")
  followers Int      @default(0)
  status    String   @default("PROSPECT") // PROSPECT | CONTACTED | AGREED | SEEDED | POSTED | PASSED
  notes     String   @default("")
  updatedAt DateTime @updatedAt
}

// ---------- Company: equity & legal (ADMIN-only pages) ----------

/// One unit issuance/transfer on the DNA Spirits LLC cap table.
model CapTableEntry {
  id           String    @id @default(cuid())
  member       String
  unitType     String    @default("ECONOMIC") // VOTING | ECONOMIC | PREFERRED
  units        Float
  dateAcquired DateTime?
  round        String    @default("") // Founder | Seed | Bridge | Secondary
  capitalCents Int       @default(0) // 0 for founder units / secondaries
  notes        String    @default("")
}

/// Index of corporate documents, IP and compliance deadlines. The executed
/// files live with counsel / in drive storage — this is the register that
/// says what exists, where it is, and when something is due.
model LegalRecord {
  id           String    @id @default(cuid())
  type         String    @default("DOCUMENT") // DOCUMENT | TRADEMARK | PERMIT | DEADLINE
  title        String
  reference    String    @default("") // USPTO serial/reg no., permit no., file no.
  jurisdiction String    @default("")
  executed     DateTime? // signed / filed / registered
  dueDate      DateTime? // renewal or filing deadline, if any
  link         String    @default("")
  status       String    @default("ACTIVE") // ACTIVE | DONE | EXPIRED
  notes        String    @default("")
}

// ---------- Ingestion inbox (staged-approval document agent) ----------

/// A document uploaded (or received) for review before it touches live data.
/// The agent parses and analyzes it, then stages the result here; an admin
/// approves (commit runs) or rejects. The raw file is kept base64 so approval
/// re-parses with the same canonical parser the direct-upload path uses.
model PendingImport {
  id         String    @id @default(cuid())
  kind       String // COMMERCIAL_REPORT | LSI_INVENTORY | QB_PNL | UNKNOWN
  filename   String
  fileB64    String // raw bytes, base64
  importerId String? // for report/inventory kinds
  period     String    @default("")
  summary    String    @default("") // human-readable, agent-written
  anomalies  String    @default("[]") // JSON array of flag strings
  proposed   String    @default("{}") // JSON preview of what will be imported
  aiUsed     Boolean   @default(false) // whether the Claude layer enriched it
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  result     String    @default("") // summary of what committed, after approval
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// ---------- Finance ----------

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  vendor      String
  category    String // COGS | DRY_GOODS | LOGISTICS | COMPLIANCE | MARKETING | G_AND_A | OTHER
  amountCents Int
  notes       String   @default("")
}

/// QuickBooks Online OAuth connection (single company). Tokens are stored
/// AES-256-GCM encrypted with a key derived from AUTH_SECRET.
model QboConnection {
  id               Int       @id @default(1)
  realmId          String
  accessTokenEnc   String
  refreshTokenEnc  String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  lastSyncAt       DateTime?
  updatedAt        DateTime  @updatedAt
}

/// A line from the bookkeeper's QuickBooks P&L export.
model FinancialEntry {
  id          String   @id @default(cuid())
  period      String // YYYY-MM
  account     String
  kind        String // INCOME | EXPENSE
  amountCents Int
  createdAt   DateTime @default(now())
}
